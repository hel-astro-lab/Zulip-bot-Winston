# Winston configuration. Copy to ~/.config/winston/winston.toml and edit.
# Relative paths are taken from this file's directory.

timezone = "Europe/Helsinki"   # for scheduled features
zuliprc = "zuliprc"            # bot credentials downloaded from Zulip (or set ZULIP_CONFIG instead)
state_file = "state.json"      # last handled message id and last fire dates
catch_up_hours = 24            # how far back a sweep looks for links posted while Winston was offline
sweep_minutes = 5              # how often it re-reads the watched channels; it also sweeps on waking

[features.arxiv]
channels = ["papers"]          # channels where an arXiv link gets a paper card

[features.help]

[features.menu]
at = "11:20"                   # weekdays only; nothing is posted on Saturday and Sunday
channel = "random"
topic = "Lunch"
grace_minutes = 120            # still post if Winston wakes up this late
restaurants = ["Chemicum Teachers restaurant", "Chemicum", "Exactum"]   # Unicafe titles, in posting order
campus = "Kumpula"             # shown in the first line of the post
lang = "en"                    # "en" or "fi"; restaurant titles follow the language

[features.digest]
at = "08:00"                   # arXiv announces at 00:00 New York time on weekdays
channel = "papers"
topic = "Daily Arxiv Highlights"
categories = ["astro-ph"]      # any arXiv category or archive, e.g. "astro-ph.HE"
announce_types = ["new", "cross"]   # add "replace" to also flag new versions of old papers
authors = "authors.txt"        # names to watch for, one per line, relative to this file
max_listed_authors = 6         # longer author lists are shortened to the first three plus the matches
# First line of the post; placeholders: {categories}, {date}, {n}, {papers} ("3 papers")
header = "**arXiv {categories}, {date}**"

[features.secret]
secrets = "secrets.txt"        # one phrase per line, told one per day in direct messages; kept out of git
